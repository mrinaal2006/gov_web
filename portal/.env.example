# Set these in Vercel: Project > Settings > Environment Variables

# Added for you when you connect a Postgres database from the Vercel Marketplace
DATABASE_URL=

# Required. A long random value. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Required. The first administrator is created from these the first time the site runs.
# The password needs at least 8 characters. Use a long, unique one on a public site.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required to add officers on Vercel: the mail account that sends verification codes.
# For Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Scores urgency with Gemini. Create the key in Google AI Studio and keep it private. Complaint text
# goes to Google, with phone and Aadhaar numbers hidden. Without a key the local model is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional
SERVICE_NAME=Samasya Radar
RESPONSE_DAYS=7
# Complaints allowed from one internet connection per hour. Keep it above 8 for the live hotspot demo.
COMPLAINTS_PER_HOUR=20

# Who runs this site, shown in the footer. The privacy notice sends people to this contact.
# Only name a government authority if it has agreed in writing to run this service and respond to complaints.
OPERATOR_NAME=
OPERATOR_CONTACT=
